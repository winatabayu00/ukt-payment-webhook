APP_NAME="UKT Payment Webhook"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://payments.example.ac.id

APP_KEY=
APP_CIPHER=AES-256-CBC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# PostgreSQL (user-managed; fill with real credentials via secret manager/env, never commit):
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ukt_payment
DB_USERNAME=ukt_app
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# API rate limits (requests/minute; see config/api.php):
API_INVOICE_RATE_LIMIT=60
API_WEBHOOK_RATE_LIMIT=300

# Production checklist (no secrets in repo):
# 1. APP_KEY set via `php artisan key:generate --show` into env/secret manager.
# 2. APP_DEBUG=false, APP_ENV=production.
# 3. Run `php artisan migrate --force` (never migrate:fresh on prod data).
# 4. Seed institutions WITHOUT demo secrets; issue real tokens:
#      php artisan institution:token CAMPUS-ALPHA
#    then distribute each plaintext token out of band (only its SHA-256 is stored).
# 5. Serve behind TLS + reverse proxy; restrict /up to health checks if needed.
